# Application
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEMO_MODE=true

# Web
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# API and security
API_HOST=0.0.0.0
API_PORT=8000
SESSION_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL and Redis
# Development-only example credentials; never reuse them in production.
DATABASE_URL=postgresql+asyncpg://zhiban:zhiban_dev_only@localhost:5432/zhiban
REDIS_URL=redis://localhost:6379/0
ALEMBIC_CONFIG_PATH=apps/api/alembic.ini
READINESS_TIMEOUT_SECONDS=1

# LLM provider (OpenAI-compatible; DeepSeek official API uses https://api.deepseek.com)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Comma-separated selectable models exposed to the frontend
LLM_MODELS=deepseek-v4-flash,deepseek-v4-pro
# Reasoning effort: low | medium | high (empty = provider default)
LLM_REASONING_EFFORT=low

# Embedding (memory semantic retrieval)
# bge-m3 (1024 dims) via SiliconFlow; CN-reachable, free tier available.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# Search provider (bocha | searxng | mock)
SEARCH_PROVIDER=bocha
SEARCH_API_KEY=
SEARCH_BASE_URL=

# Email (SMTP) delivery for reminders. Disabled by default (in-app only).
# Set SMTP_ENABLED=true and fill in the rest to enable email reminders.
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com，SMTP_PORT=465（SSL，SMTP_USE_TLS 会被忽略）。
# 163 邮箱：SMTP_HOST=smtp.163.com，SMTP_PORT=465。
# Gmail：SMTP_HOST=smtp.gmail.com，SMTP_PORT=587（STARTTLS，SMTP_USE_TLS=true）。
# SMTP_PASSWORD 填邮箱服务商生成的「授权码」，不是登录密码。
SMTP_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=知伴 <no-reply@example.com>
SMTP_USE_TLS=true
